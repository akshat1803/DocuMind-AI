NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Database Connection (Supabase Transaction Pooler or Direct Connection string)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres"

# JWT Auth Secrets
JWT_ACCESS_SECRET="develop_only_jwt_access_secret_change_me_in_production"
JWT_REFRESH_SECRET="develop_only_jwt_refresh_secret_change_me_in_production"
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Gemini API Integration
GEMINI_API_KEY="AIzaSy..."
GEMINI_CHAT_MODEL="gemini-3.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Storage Settings
STORAGE_DIR=".uploads"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
MAX_FILE_SIZE_MB=20
MAX_DOCUMENTS_PER_USER=20
 